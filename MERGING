import pandas as pd
from pathlib import Path

# Folder where your CSVs are stored
data_dir = Path("dataset")  # adjust if needed

# Pattern to match all relevant CSV files
csv_files = sorted(data_dir.glob("openb_pod_list_*.csv"))

# Merge all CSVs, adding 'source_file' to track origin
merged_df = pd.concat(
    [pd.read_csv(file).assign(source_file=file.name) for file in csv_files],
    ignore_index=True
)

# Output path
output_path = data_dir / "merged_openb_all_with_source.csv"
merged_df.to_csv(output_path, index=False)

print(f"✅ Merged {len(csv_files)} files into '{output_path.name}' with {len(merged_df)} total rows.")
